{
  "expo": {
    "name": "OpenCode",
    "slug": "opencode-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "opencode",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.opencode.mobile",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "UIDesignRequiresCompatibility": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "edgeToEdgeEnabled": true,
      "package": "ai.opencode.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/geist.ttf", "./assets/fonts/geist-italic.ttf", "./assets/fonts/geist-mono.ttf"]
        }
      ]
    ]
  }
}
