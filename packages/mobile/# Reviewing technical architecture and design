01010| export function loadConfig(): ClawdisConfig {
01011|   // Read config file (JSON5) if present.
01012|   const configPath = CONFIG_PATH_CLAWDIS;
01013|   try {
01014|     if (!fs.existsSync(configPath)) return {};
01015|     const raw = fs.readFileSync(configPath, "utf-8");
01016|     const parsed = JSON5.parse(raw);
01017|     if (typeof parsed !== "object" || parsed === null) return {};
01018|     const validated = ClawdisSchema.safeParse(parsed);
01019|     if (!validated.success) {
01020|       console.error("Invalid config:");
01021|       for (const iss of validated.error.issues) {
01022|         console.error(`- ${iss.path.join(".")}: ${iss.message}`);
01023|       }
01024|       return {};
01025|     }
01026|     return applyIdentityDefaults(validated.data as ClawdisConfig);
01027|   } catch (err) {
01028|     console.error(`Failed to read config at ${configPath}`, err);
01029|     return {};
01030|   }
01031| }
