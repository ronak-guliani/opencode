### 1.3 CLI Command for Copilot Login

**New file:** `src/cli/commands/login-copilot.ts`

```typescript
import ora from "ora";
import chalk from "chalk";
import { initiateDeviceFlow, pollAccessToken, getCopilotToken } from "../../infra/auth/github-copilot-oauth.js";
import { loadOAuthStorageAt, saveOAuthStorageAt, resolveClawdisOAuthPath } from "../../infra/auth/oauth-storage.js";

export async function loginCopilotCommand(options: {
  enterprise?: string; // Optional GHE domain
}) {
  const spinner = ora("Initiating GitHub OAuth device flow...").start();

  try {
    // Step 1: Initiate device flow
    const { verification_uri, user_code, device_code, interval } =
      await initiateDeviceFlow();

    spinner.stop();

    console.log(chalk.bold("\n🔐 GitHub Copilot Login\n"));
    console.log(`1. Visit: ${chalk.cyan(verification_uri)}`);
    console.log(`2. Enter code: ${chalk.yellow.bold(user_code)}`);
    console.log("\nWaiting for authorization...\n");

    // Step 2: Poll for OAuth token
    spinner.start("Waiting for user authorization...");
    const oauthToken = await pollAccessToken(device_code, interval);
    spinner.succeed("GitHub OAuth authorized!");

    // Step 3: Exchange for Copilot API token
    spinner.start("Obtaining Copilot API token...");
    const { token, expires_at } = await getCopilotToken(
      oauthToken,
      options.enterprise
    );

    // Step 4: Save to OAuth storage
    const oauthPath = resolveClawdisOAuthPath();
    const storage = loadOAuthStorageAt(oauthPath) || {};

    storage["github-copilot"] = {
      type: "oauth",
      refresh: oauthToken,
      access: token,
      expires: expires_at * 1000,
      ...(options.enterprise && { enterpriseUrl: options.enterprise }),
    };

    saveOAuthStorageAt(oauthPath, storage);

    spinner.succeed(chalk.green("✅ GitHub Copilot authenticated!"));
    console.log(`\nCredentials saved to: ${chalk.dim(oauthPath)}\n`);

  } catch (error) {
    spinner.fail(chalk.red("GitHub Copilot login failed"));
    throw error;
  }
}
```

**Why:** Users need a simple `clawdis login copilot` command to set up authentication.

