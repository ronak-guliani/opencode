01064| function readTalkApiKeyFromProfile(): string | null {
01065|   const home = os.homedir();
01066|   const candidates = [".profile", ".zprofile", ".zshrc", ".bashrc"].map(
01067|     (name) => path.join(home, name),
01068|   );
01069|   for (const candidate of candidates) {
01070|     if (!fs.existsSync(candidate)) continue;
01071|     try {
01072|       const text = fs.readFileSync(candidate, "utf-8");
01073|       const match = text.match(
01074|         /(?:^|\n)\s*(?:export\s+)?ELEVENLABS_API_KEY\s*=\s*["']?([^\n"']+)["']?/,
01075|       );
01076|       const value = match?.[1]?.trim();
01077|       if (value) return value;
01078|     } catch {
01079|       // Ignore profile read errors.
01080|     }
01081|   }
01082|   return null;
01083| }
