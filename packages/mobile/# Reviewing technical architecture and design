### 5.3 Add `/provider` Chat Command

**File:** `src/commands/provider.ts` (new file)

```typescript
import type { CommandContext } from "./types.js";
import { getSession, updateSession } from "../gateway/sessions.js";

export async function handleProviderCommand(
  provider: string,
  context: CommandContext
): Promise<string> {
  const validProviders = ["anthropic", "github-copilot"];

  if (!validProviders.includes(provider)) {
    return (
      `❌ Invalid provider: ${provider}\n\n` +
      `Valid options:\n` +
      `  • anthropic — Claude with extended thinking\n` +
      `  • github-copilot — Multiple models, no thinking\n\n` +
      `Example: /provider anthropic`
    );
  }

  const session = await getSession(context.sessionId);
  const oldProvider = session.provider || "anthropic";

  if (oldProvider === provider) {
    return `Provider is already set to: ${provider}`;
  }

  // Update session
  await updateSession(context.sessionId, { provider });

  // Reset model to default for new provider
  const defaultModel = provider === "github-copilot"
    ? "gpt-5-mini"
    : "claude-opus-4-5";
  await updateSession(context.sessionId, { model: defaultModel });

  let message = `✅ Provider switched: ${oldProvider} → ${provider}\n`;
  message += `   Model reset to: ${defaultModel}\n\n`;

  if (provider === "github-copilot") {
    message += (
      "⚠️ Note: Extended thinking is not available with GitHub Copilot.\n" +
      "   Thinking level will be set to 'off'.\n"
    );
    await updateSession(context.sessionId, { thinking: "off" });
  }

  return message;
}
```

