### 1.2 Implement OAuth Device Flow (if Pi doesn't handle it)

**Only needed if Pi's implementation is incomplete.**

**New file:** `src/infra/auth/github-copilot-oauth.ts`

```typescript
import type { OAuthStorage } from "@mariozechner/pi-ai";

export interface GitHubCopilotAuth {
  type: "oauth";
  refresh: string;      // GitHub OAuth token (gho_xxx)
  access: string;       // Copilot API token (copilot_token_xxx)
  expires: number;      // Timestamp
  enterpriseUrl?: string; // Optional for GHE
}

/**
 * GitHub OAuth Device Code Flow
 * https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps#device-flow
 */
export async function initiateDeviceFlow(): Promise<{
  verification_uri: string;
  user_code: string;
  device_code: string;
  interval: number;
}> {
  const response = await fetch("https://github.com/login/device/code", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      client_id: "Iv1.b507a08c87ecfe98", // OpenCode's public client ID
      scope: "read:user",
    }),
  });

  if (!response.ok) {
    throw new Error(`Device flow init failed: ${response.statusText}`);
  }

  return response.json();
}

/**
 * Poll for access token after user authorizes
 */
export async function pollAccessToken(
  deviceCode: string,
  interval: number
): Promise<string> {
  const maxAttempts = 120; // 10 minutes max

  for (let i = 0; i < maxAttempts; i++) {
    await new Promise(resolve => setTimeout(resolve, interval * 1000));

    const response = await fetch("https://github.com/login/oauth/access_token", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify({
        client_id: "Iv1.b507a08c87ecfe98",
        device_code: deviceCode,
        grant_type: "urn:ietf:params:oauth:grant-type:device_code",
      }),
    });

    const data = await response.json();

    if (data.error === "authorization_pending") continue;
    if (data.error === "slow_down") {
      interval += 5;
      continue;
    }
    if (data.error) throw new Error(`OAuth error: ${data.error}`);

    return data.access_token; // GitHub OAuth token
  }

  throw new Error("Device flow timed out");
}

/**
 * Exchange GitHub OAuth token for Copilot API token
 */
export async function getCopilotToken(
  oauthToken: string,
  enterpriseDomain?: string
): Promise<{ token: string; expires_at: number }> {
  const domain = enterpriseDomain || "github.com";

  const response = await fetch(
    `https://api.${domain}/copilot_internal/v2/token`,
    {
      headers: {
        Authorization: `Bearer ${oauthToken}`,
        "User-Agent": "Clawdis/1.0",
        "Editor-Version": "clawdis/1.0.0",
        "Editor-Plugin-Version": "clawdis/1.0.0",
        "Copilot-Integration-Id": "clawdis",
      },
    }
  );

  if (!response.ok) {
    throw new Error(`Copilot token exchange failed: ${response.statusText}`);
  }

  return response.json();
}

/**
 * Refresh Copilot API token if expired
 */
export async function refreshCopilotTokenIfNeeded(
  auth: GitHubCopilotAuth
): Promise<GitHubCopilotAuth> {
  if (auth.expires > Date.now()) return auth; // Not expired

  const { token, expires_at } = await getCopilotToken(
    auth.refresh,
    auth.enterpriseUrl
  );

  return {
    ...auth,
    access: token,
    expires: expires_at * 1000,
  };
}
```

**Why:** GitHub Copilot requires a two-stage auth flow (OAuth → API token) with automatic refresh, unlike Anthropic's static API keys.

