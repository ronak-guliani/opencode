00984| function applyIdentityDefaults(cfg: ClawdisConfig): ClawdisConfig {
00985|   const identity = cfg.identity;
00986|   if (!identity) return cfg;
00987|
00988|   const name = identity.name?.trim();
00989|
00990|   const routing = cfg.routing ?? {};
00991|   const groupChat = routing.groupChat ?? {};
00992|
00993|   let mutated = false;
00994|   const next: ClawdisConfig = { ...cfg };
00995|
00996|   if (name && !groupChat.mentionPatterns) {
00997|     const parts = name.split(/\s+/).filter(Boolean).map(escapeRegExp);
00998|     const re = parts.length ? parts.join("\\s+") : escapeRegExp(name);
00999|     const pattern = `\\b@?${re}\\b`;
01000|     next.routing = {
01001|       ...(next.routing ?? routing),
01002|       groupChat: { ...groupChat, mentionPatterns: [pattern] },
01003|     };
01004|     mutated = true;
01005|   }
01006|
01007|   return mutated ? next : cfg;
01008| }
