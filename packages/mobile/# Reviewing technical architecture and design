import { loginGitHubCopilot, type OAuthCredentials } from "@mariozechner/pi-ai";
import chalk from "chalk";
import ora from "ora";
import { createInterface } from "node:readline";

export async function loginCopilotCommand(options: {
  enterprise?: string;
}): Promise<void> {
  const spinner = ora("Initializing GitHub Copilot login...").start();

  const readline = createInterface({
    input: process.stdin,
    output: process.stdout
  });

  const prompt = (message: string): Promise<string> => {
    return new Promise((resolve) => {
      readline.question(message, (answer) => {
        resolve(answer);
      });
    });
  };

  try {
    spinner.stop();
    console.log(chalk.bold("\n🤖 GitHub Copilot Login\n"));

    const credentials = await loginGitHubCopilot({
      onAuth: (url, instructions) => {
        console.log(`1. Visit: ${chalk.cyan(url)}`);
        if (instructions) {
          console.log(`2. Enter code: ${chalk.yellow.bold(instructions)}\n`);
        }
        spinner.start("Waiting for authorization...");
      },
      onPrompt: async (promptInfo) => {
        spinner.stop();
        const answer = await prompt(`${promptInfo.message}: `);
        if (!promptInfo.allowEmpty && !answer.trim()) {
          throw new Error("Input required");
        }
        return answer;
      },
      onProgress: (message) => {
        spinner.text = message;
      }
    });

    // Save to Clawdis OAuth storage
    const { loadOAuthStorageAt, saveOAuthStorageAt, resolveClawdisOAuthPath } =
      await import("../../agents/pi-embedded-runner.js");

    const oauthPath = resolveClawdisOAuthPath();
    const storage = loadOAuthStorageAt(oauthPath) || {};

    storage["github-copilot"] = credentials;
    saveOAuthStorageAt(oauthPath, storage);

    spinner.succeed(chalk.green("✅ GitHub Copilot authenticated!"));
    console.log(`\nCredentials saved to: ${chalk.dim(oauthPath)}`);

    if (options.enterprise) {
      console.log(`Enterprise domain: ${chalk.cyan(options.enterprise)}\n`);
    }

  } catch (error) {
    spinner.fail(chalk.red("GitHub Copilot login failed"));
    console.error(chalk.red((error as Error).message));
    process.exit(1);
  } finally {
    readline.close();
  }
}
```

