        verboseLevel: params.verboseLevel,
        shouldEmitToolResult: params.shouldEmitToolResult,
        onToolResult: params.onToolResult,
        onPartialReply: params.onPartialReply,
        onAgentEvent: params.onAgentEvent,
      });

